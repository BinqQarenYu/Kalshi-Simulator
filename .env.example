# Kalshi Demo API Credentials
# Generate at: https://demo.kalshi.com → Account Settings → API Keys
KALSHI_API_KEY_ID=your-api-key-id-here
KALSHI_PRIVATE_KEY_PATH=./keys/kalshi_demo.pem

# Environment lock — MUST be "demo" (safety check enforced in code)
KALSHI_ENV=demo

# Timeframes to subscribe (comma-separated): 5m, 15m, 1h, daily
KALSHI_TIMEFRAMES=15m
