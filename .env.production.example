# ==============================================================================
# Kalshi Bot 1 V4 — Production Environment Configuration (AWS EC2)
# ==============================================================================

# Kalshi RSA Authentication
KALSHI_API_KEY_ID=your_kalshi_api_key_id_here
KALSHI_PRIVATE_KEY_PATH=/opt/kalshi-simulator/keys/kalshi.pem

# Trading Operational Mode
KALSHI_MODE=live
KALSHI_ENV=live
KALSHI_LIVE_TRADING_ENABLED=true
ACTIVE_STRATEGY_BOT=bot1_v4_domination

# Dynamic Sizing & Guardrails (docs/SCALEUP.md)
MAX_RISK_PCT_PER_TRADE=8.0
MIN_ORDER_INTERVAL_SECONDS=45.0
ALLOW_SCALEUP_CONVICTION=true

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
